{
  "name": "sf-tennis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "tennis.marvinaziz.de/*",
      "zone_name": "marvinaziz.de"
    }
  ]
}
